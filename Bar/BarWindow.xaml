<!-- The menu bar. Window chrome, glass and position come from ShellWindow (Bar/ShellWindow.cs) and Native/AppBar,
     so no Left/Top/Width or window styles here. Colors come from Themes/ThemeManager via DynamicResource. -->
<b:ShellWindow x:Class="MacShell.Bar.BarWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:b="clr-namespace:MacShell.Bar"
               Title="MacShell Bar">
    <Border Background="{DynamicResource Theme.BarFill}"
            BorderBrush="{DynamicResource Theme.Hairline}"
            BorderThickness="0,0,0,1">
        <!-- Three columns, like a Compose Row with a weight(1f) spacer in the middle: left | stretch | right. -->
        <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Filled from config.json (bar.left / bar.right) by BarWindow.BuildWidgets. -->
            <StackPanel x:Name="LeftItems" Grid.Column="0" Orientation="Horizontal" />
            <StackPanel x:Name="RightItems" Grid.Column="2" Orientation="Horizontal" />
        </Grid>
    </Border>
</b:ShellWindow>
