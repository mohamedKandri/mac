<!-- "82%" + battery outline whose fill follows the level. Charging: a bolt instead of the fill.
     20% or less on battery: the fill turns Theme.Warning. Hidden on PCs without a battery.
     Drawn on a 26x24 grid (the canvas battery icon), shown at 20x16 (whose height matches the other icons). -->
<UserControl x:Class="MacShell.Widgets.BatteryWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button x:Name="Button" Style="{StaticResource Shell.BarButton}" Click="OnClick">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Percent" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Viewbox Width="20" Height="16">
                <Canvas Width="26" Height="24">
                    <!-- Outline and the little nub on the right -->
                    <Path Data="M5,6 H18 A3,3 0 0 1 21,9 V15 A3,3 0 0 1 18,18 H5 A3,3 0 0 1 2,15 V9 A3,3 0 0 1 5,6 Z M24,10 V14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <!-- Level: up to 13 units wide (x 5..18); width and color (normal / warning) set from code -->
                    <Rectangle x:Name="Level" Canvas.Left="5" Canvas.Top="9" Height="6" RadiusX="1" RadiusY="1" />
                    <!-- Charging bolt -->
                    <Path x:Name="Bolt" Visibility="Collapsed" Data="M12.5,7.5 L8.5,12.5 H11.5 L10.5,16.5 L14.5,11.5 H11.5 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
            </Viewbox>
        </StackPanel>
    </Button>
</UserControl>
