<!-- Date and time, e.g. "Wed 21 Oct  10:01". Click: month calendar (CalendarPopup). -->
<UserControl x:Class="MacShell.Widgets.ClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button x:Name="Button" Style="{StaticResource Shell.BarButton}" Click="OnClick">
        <TextBlock x:Name="Time" FontWeight="Medium" VerticalAlignment="Center" />
    </Button>
</UserControl>
