<!-- Wi-Fi icon + network name. Disconnected: crossed-out icon in the muted color. Hidden without a Wi-Fi adapter.
     Click: Windows' own network list flyout. -->
<UserControl x:Class="MacShell.Widgets.WifiWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:MacShell.Themes">
    <Button x:Name="Button" Style="{StaticResource Shell.BarButton}" Click="OnClick">
        <StackPanel Orientation="Horizontal">
            <t:LineIcon x:Name="Icon" Data="{StaticResource Icon.Wifi}" FillData="{StaticResource Icon.WifiDot}" />
            <TextBlock x:Name="NetworkName" VerticalAlignment="Center" Margin="6,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Button>
</UserControl>
