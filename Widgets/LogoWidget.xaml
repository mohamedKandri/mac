<!-- The logo at the far left. Clicking it opens the power menu (PowerMenu.xaml). -->
<UserControl x:Class="MacShell.Widgets.LogoWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:MacShell.Themes">
    <Button x:Name="Button" Style="{StaticResource Shell.BarButton}" Width="28" Padding="0"
            ToolTip="Power" Click="OnClick">
        <t:LineIcon Data="{StaticResource Icon.Logo}" FillData="{StaticResource Icon.LogoDot}" Width="14" Height="14" />
    </Button>
</UserControl>
