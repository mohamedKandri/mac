<!-- Name of the app in front, e.g. "Microsoft Edge". Long names end in "…". -->
<UserControl x:Class="MacShell.Widgets.ActiveAppWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TextBlock x:Name="AppName" FontWeight="SemiBold" Margin="6,0" MaxWidth="360"
               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
</UserControl>
